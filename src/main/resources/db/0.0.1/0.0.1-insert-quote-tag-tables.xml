<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet id="1" author="yakimovich_sv">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="quotes"/>
        </preConditions>
        <insert tableName="quotes">
            <column name="author" value="admin"/>
            <column name="information" value="Пиво – интеллектуальный напиток, который, к сожалению, пьет слишком много идиотов. (Рэй Брэдбери)" />
            <column name="created_at" value="now()"/>
            <column name="used" value="false"/>
            <column name="language" value="RU"/>
        </insert>
        <insert tableName="quotes">
            <column name="author" value="admin"/>
            <column name="information" value="Деньги не сделают вас счастливее. У меня сейчас 50 миллионов, и я так же счастлив, как и тогда, когда у меня было 48 миллионов. (Арнольд Шварценеггер)" />
            <column name="created_at" value="now()"/>
            <column name="used" value="false"/>
            <column name="language" value="RU"/>
        </insert>
        <insert tableName="quotes">
            <column name="author" value="admin"/>
            <column name="information" value="Руководить — это значит не мешать хорошим людям работать. (Петр Капица)" />
            <column name="created_at" value="now()"/>
            <column name="used" value="false"/>
            <column name="language" value="RU"/>
        </insert>
    </changeSet>

    <changeSet id="2" author="yakimovich_sv">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="quotes_tags"/>
        </preConditions>
        <insert tableName="quotes_tags">
            <column name="tag_id" value="1" />
            <column name="quote_id" value="1" />
        </insert>
        <insert tableName="quotes_tags">
            <column name="tag_id" value="4" />
            <column name="quote_id" value="2" />
        </insert>
        <insert tableName="quotes_tags">
            <column name="tag_id" value="3" />
            <column name="quote_id" value="3" />
        </insert>
    </changeSet>

</databaseChangeLog>