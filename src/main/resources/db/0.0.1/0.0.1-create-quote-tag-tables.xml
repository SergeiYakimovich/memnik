<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet id="1" author="yakimovich_sv">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="quotes"/>
            </not>
        </preConditions>
        <createTable tableName="quotes" remarks="Таблица цитат">
            <column name="id" type="serial" remarks="ID" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="author" type="varchar(255)" remarks="Автор цитаты">
                <constraints nullable="false"/>
            </column>
            <column name="information" type="varchar(255)" remarks="Информация">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" remarks="Дата создания">
                <constraints nullable="false"/>
            </column>
            <column name="used" type="boolean" remarks="Использовано">
                <constraints nullable="false"/>
            </column>
            <column name="language" type="varchar(10)" remarks="Язык">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="yakimovich_sv">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="quotes_tags"/>
            </not>
        </preConditions>
        <createTable tableName="quotes_tags" remarks="Таблица quotes_tags">
            <column name="quote_id" type="bigint" remarks="ID цитаты">
                <constraints nullable="false"/>
            </column>
            <column name="tag_id" type="bigint" remarks="ID тега">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>