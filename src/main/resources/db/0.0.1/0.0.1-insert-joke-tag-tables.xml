<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <changeSet id="1" author="yakimovich_sv">
        <preConditions onFail="MARK_RAN">
                <tableExists tableName="tags"/>
        </preConditions>
        <insert tableName="tags">
            <column name="author" value="admin"/>
            <column name="name" value="sex" />
            <column name="created_at" value="now()"/>
        </insert>
    </changeSet>

    <changeSet id="2" author="yakimovich_sv">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="jokes"/>
        </preConditions>
        <insert tableName="jokes">
            <column name="author" value="admin"/>
            <column name="information" value="Какие три слова страшнее всего услышать, занимаясь любовью? - Дорогая, я вернулся!" />
            <column name="created_at" value="now()"/>
            <column name="used" value="false"/>
            <column name="language" value="RU"/>
        </insert>
        <insert tableName="jokes">
            <column name="author" value="admin"/>
            <column name="information" value="Деньги не приносят счастья, но на них можно купить яхту со шлюхами. А я никогда не видел кого-то несчастным на яхте со шлюхами (Пауло Коэльо)" />
            <column name="created_at" value="now()"/>
            <column name="used" value="false"/>
            <column name="language" value="RU"/>
        </insert>
        <insert tableName="jokes">
            <column name="author" value="admin"/>
            <column name="information" value="- У вас есть сбережения на черный день? - Конечно. Даже на два" />
            <column name="created_at" value="now()"/>
            <column name="used" value="false"/>
            <column name="language" value="RU"/>
        </insert>
    </changeSet>

    <changeSet id="3" author="yakimovich_sv">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="jokes_tags"/>
        </preConditions>
        <insert tableName="jokes_tags">
            <column name="tag_id" value="5" />
            <column name="joke_id" value="1" />
        </insert>
        <insert tableName="jokes_tags">
            <column name="tag_id" value="4" />
            <column name="joke_id" value="2" />
        </insert>
        <insert tableName="jokes_tags">
            <column name="tag_id" value="4" />
            <column name="joke_id" value="3" />
        </insert>
    </changeSet>

</databaseChangeLog>